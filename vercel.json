{
  "version": 2,
  "outputDirectory": "public",
  "functions": {
    "api/ai.js":      { "maxDuration": 30 },
    "api/analyze.js": { "maxDuration": 55 },
    "api/bracket.js": { "maxDuration": 10 }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/(.*)",     "dest": "/$1" }
  ]
}
