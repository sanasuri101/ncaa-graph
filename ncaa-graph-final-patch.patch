diff --git a/public/odds.js b/public/odds.js
new file mode 100644
index 0000000..0877e64
--- /dev/null
+++ b/public/odds.js
@@ -0,0 +1,309 @@
+/**
+ * odds.js — Dedicated odds page
+ *
+ * Renders DraftKings lines, ESPN BPI predictions, line movement,
+ * and futures for all tournament games.
+ *
+ * Reads from public/data/espn_odds.json (generated by scripts/fetch_odds.py).
+ */
+
+'use strict';
+
+let _oddsData   = null;
+let _oddsTab    = 'upcoming';
+let _oddsLoaded = false;
+
+// ── Init: wire tab buttons ────────────────────────────────────────────────────
+document.querySelectorAll('.odds-tab').forEach(btn => {
+  btn.addEventListener('click', () => {
+    document.querySelectorAll('.odds-tab').forEach(b => b.classList.remove('active'));
+    btn.classList.add('active');
+    _oddsTab = btn.dataset.oddsTab;
+    renderOddsTab();
+  });
+});
+
+// ── Load odds data when Odds view is activated ────────────────────────────────
+async function loadOddsIfNeeded() {
+  if (_oddsLoaded) { renderOddsTab(); return; }
+  const el = document.getElementById('odds-content');
+  if (!el) return;
+  el.innerHTML = '<div class="odds-loading">Loading odds…</div>';
+  try {
+    const res = await fetch('/data/espn_odds.json');
+    if (!res.ok) throw new Error(`HTTP ${res.status}`);
+    _oddsData   = await res.json();
+    _oddsLoaded = true;
+    renderOddsTab();
+  } catch (err) {
+    el.innerHTML = `<div class="odds-error">Could not load odds data: ${err.message}</div>`;
+  }
+}
+
+// ── Main render dispatcher ────────────────────────────────────────────────────
+function renderOddsTab() {
+  if (!_oddsData) return;
+  const el = document.getElementById('odds-content');
+  if (!el) return;
+
+  if (_oddsTab === 'upcoming')   el.innerHTML = renderUpcoming();
+  if (_oddsTab === 'completed')  el.innerHTML = renderCompleted();
+  if (_oddsTab === 'futures')    el.innerHTML = renderFutures();
+}
+
+// ── Helpers ───────────────────────────────────────────────────────────────────
+function impliedToAmerican(imp) {
+  if (!imp) return '—';
+  if (imp >= 50) return `-${Math.round(imp / (100 - imp) * 100)}`;
+  return `+${Math.round((100 - imp) / imp * 100)}`;
+}
+
+function movementBadge(mv) {
+  if (mv === null || mv === undefined) return '';
+  const abs = Math.abs(mv).toFixed(1);
+  if (Math.abs(mv) < 1.5) return '';
+  const dir  = mv > 0 ? '▲' : '▼';
+  const cls  = mv > 0 ? 'mv-up' : 'mv-down';
+  return `<span class="mv-badge ${cls}">${dir} ${abs}%</span>`;
+}
+
+function roundLabel(date) {
+  if (!date) return '';
+  const d = date.slice(5); // MM-DD
+  if (d <= '03-18') return 'First Four';
+  if (d <= '03-20') return 'Round of 64';
+  if (d <= '03-22') return 'Round of 32';
+  if (d <= '03-28') return 'Sweet 16';
+  if (d <= '03-30') return 'Elite Eight';
+  if (d <= '04-05') return 'Final Four';
+  return 'Championship';
+}
+
+function regionColor(teamId) {
+  if (!window.META || !window.GRAPH_DATA) return 'var(--accent)';
+  const node = window.GRAPH_DATA?.nodes?.find(n => n.id === String(teamId));
+  if (!node) return 'var(--accent)';
+  const colors = { East:'var(--east)', West:'var(--west)', South:'var(--south)', Midwest:'var(--midwest)' };
+  return colors[node.region] || 'var(--accent)';
+}
+
+// ── Render: upcoming games ────────────────────────────────────────────────────
+function renderUpcoming() {
+  const games = Object.values(_oddsData.games || {})
+    .filter(g => !g.completed && g.odds)
+    .sort((a, b) => a.date.localeCompare(b.date));
+
+  if (!games.length) return '<div class="odds-empty">No upcoming games with odds found.</div>';
+
+  // Group by date
+  const byDate = {};
+  games.forEach(g => { (byDate[g.date] = byDate[g.date] || []).push(g); });
+
+  return Object.entries(byDate).map(([date, dateGames]) => {
+    const d = new Date(date + 'T12:00:00');
+    const label = d.toLocaleDateString('en-US', { weekday: 'long', month: 'short', day: 'numeric' });
+    const round = roundLabel(date);
+    const cards = dateGames.map(g => gameCard(g, false)).join('');
+    return `
+      <div class="odds-date-group">
+        <div class="odds-date-header">
+          <span class="odds-date-label">${label}</span>
+          <span class="odds-round-badge">${round}</span>
+        </div>
+        <div class="odds-cards">${cards}</div>
+      </div>`;
+  }).join('');
+}
+
+// ── Render: completed games ────────────────────────────────────────────────────
+function renderCompleted() {
+  const games = Object.values(_oddsData.games || {})
+    .filter(g => g.completed && g.odds)
+    .sort((a, b) => b.date.localeCompare(a.date));
+
+  if (!games.length) return '<div class="odds-empty">No completed games with odds data.</div>';
+
+  const byDate = {};
+  games.forEach(g => { (byDate[g.date] = byDate[g.date] || []).push(g); });
+
+  return Object.entries(byDate).map(([date, dateGames]) => {
+    const d = new Date(date + 'T12:00:00');
+    const label = d.toLocaleDateString('en-US', { weekday: 'long', month: 'short', day: 'numeric' });
+    const round = roundLabel(date);
+    const cards = dateGames.map(g => gameCard(g, true)).join('');
+    return `
+      <div class="odds-date-group">
+        <div class="odds-date-header">
+          <span class="odds-date-label">${label}</span>
+          <span class="odds-round-badge">${round}</span>
+        </div>
+        <div class="odds-cards">${cards}</div>
+      </div>`;
+  }).join('');
+}
+
+// ── Individual game card ──────────────────────────────────────────────────────
+function gameCard(g, isCompleted) {
+  const o   = g.odds;
+  const bpi = g.bpi;
+
+  const homeName  = g.home_name || 'Home';
+  const awayName  = g.away_name || 'Away';
+  const spread    = o.spread != null ? (o.spread > 0 ? `+${o.spread}` : `${o.spread}`) : '—';
+  const ouStr     = o.over_under != null ? o.over_under : '—';
+  const homeML    = o.home_moneyline != null ? (o.home_moneyline > 0 ? `+${o.home_moneyline}` : `${o.home_moneyline}`) : '—';
+  const awayML    = o.away_moneyline != null ? (o.away_moneyline > 0 ? `+${o.away_moneyline}` : `${o.away_moneyline}`) : '—';
+  const homeImp   = o.home_implied_pct != null ? `${o.home_implied_pct}%` : '';
+  const awayImp   = o.away_implied_pct != null ? `${o.away_implied_pct}%` : '';
+
+  // BPI
+  const bpiRow = bpi ? `
+    <div class="gc-bpi-row">
+      <span class="gc-bpi-label">BPI</span>
+      <span class="gc-bpi-home">${bpi.home_bpi_win_pct}%</span>
+      <div class="gc-bpi-bar">
+        <div class="gc-bpi-fill" style="width:${bpi.home_bpi_win_pct}%"></div>
+      </div>
+      <span class="gc-bpi-away">${bpi.away_bpi_win_pct}%</span>
+      <span class="gc-bpi-quality" title="Matchup quality 0-100">Q: ${bpi.matchup_quality}</span>
+    </div>` : '';
+
+  // Line movement
+  const mv = o.line_movement;
+  const mvNote = mv !== null && mv !== undefined && Math.abs(mv) >= 1.5
+    ? `<div class="gc-movement">
+        ${mv > 0
+          ? `Sharp money on <strong>${homeName}</strong> — line moved ${mv.toFixed(1)}% toward home`
+          : `Sharp money on <strong>${awayName}</strong> — line moved ${Math.abs(mv).toFixed(1)}% toward away`}
+       </div>`
+    : '';
+
+  const openHomeML = o.open_home_ml;
+  const openNote   = openHomeML != null
+    ? `<div class="gc-open">Open: ${openHomeML > 0 ? '+' : ''}${openHomeML}</div>`
+    : '';
+
+  const completedBadge = isCompleted ? '<span class="gc-final-badge">FINAL</span>' : '';
+
+  return `
+    <div class="odds-card ${isCompleted ? 'oc-completed' : ''}">
+      <div class="gc-header">
+        <div class="gc-matchup">
+          <div class="gc-team gc-home">
+            <span class="gc-team-name">${homeName}</span>
+            <span class="gc-team-role">Home</span>
+          </div>
+          <div class="gc-vs">vs</div>
+          <div class="gc-team gc-away">
+            <span class="gc-team-name">${awayName}</span>
+            <span class="gc-team-role">Away</span>
+          </div>
+        </div>
+        ${completedBadge}
+      </div>
+      <div class="gc-lines">
+        <div class="gc-line-block">
+          <div class="gc-line-label">SPREAD</div>
+          <div class="gc-line-value">${spread}</div>
+        </div>
+        <div class="gc-line-block">
+          <div class="gc-line-label">O/U</div>
+          <div class="gc-line-value">${ouStr}</div>
+        </div>
+        <div class="gc-line-block">
+          <div class="gc-line-label">HOME ML</div>
+          <div class="gc-line-value">${homeML} <span class="gc-implied">${homeImp}</span></div>
+        </div>
+        <div class="gc-line-block">
+          <div class="gc-line-label">AWAY ML</div>
+          <div class="gc-line-value">${awayML} <span class="gc-implied">${awayImp}</span></div>
+        </div>
+      </div>
+      ${bpiRow}
+      ${openNote}
+      ${mvNote}
+    </div>`;
+}
+
+// ── Render: futures ───────────────────────────────────────────────────────────
+function renderFutures() {
+  const futures = _oddsData.futures || {};
+  if (!Object.keys(futures).length) return '<div class="odds-empty">No futures data available.</div>';
+
+  // Find championship market entries
+  const champEntries = Object.entries(futures)
+    .map(([name, data]) => {
+      const champ = data.markets?.championship;
+      if (!champ) return null;
+      return { name, moneyline: champ.moneyline, implied: champ.implied_pct };
+    })
+    .filter(Boolean)
+    .sort((a, b) => b.implied - a.implied);
+
+  // Regional winner entries
+  const regionMarkets = {};
+  Object.entries(futures).forEach(([name, data]) => {
+    Object.entries(data.markets || {}).forEach(([mkt, val]) => {
+      if (mkt.startsWith('region_')) {
+        const region = mkt.replace('region_', '').replace('_', ' ');
+        if (!regionMarkets[region]) regionMarkets[region] = [];
+        regionMarkets[region].push({ name, moneyline: val.moneyline, implied: val.implied_pct });
+      }
+    });
+  });
+  Object.values(regionMarkets).forEach(arr => arr.sort((a, b) => b.implied - a.implied));
+
+  const champHTML = champEntries.length ? `
+    <div class="futures-section">
+      <div class="futures-section-title">🏆 National Championship</div>
+      <div class="futures-grid">
+        ${champEntries.map((e, i) => futureRow(e, i)).join('')}
+      </div>
+    </div>` : '';
+
+  const regionHTMLs = Object.entries(regionMarkets).map(([region, entries]) => {
+    const regionCls = region.trim().toLowerCase().split(' ')[0];
+    return `
+      <div class="futures-section">
+        <div class="futures-section-title futures-region-title ${regionCls}-text">${region.charAt(0).toUpperCase() + region.slice(1)} Regional</div>
+        <div class="futures-grid">
+          ${entries.map((e, i) => futureRow(e, i)).join('')}
+        </div>
+      </div>`;
+  }).join('');
+
+  return `<div class="futures-page">${champHTML}${regionHTMLs}</div>`;
+}
+
+function futureRow(entry, rank) {
+  const mlStr = entry.moneyline > 0 ? `+${entry.moneyline}` : `${entry.moneyline}`;
+  const barW  = Math.min(entry.implied * 2.5, 100);
+  const medal = rank === 0 ? '🥇' : rank === 1 ? '🥈' : rank === 2 ? '🥉' : `${rank + 1}.`;
+  return `
+    <div class="future-row">
+      <span class="future-rank">${medal}</span>
+      <span class="future-name">${entry.name}</span>
+      <div class="future-bar-wrap">
+        <div class="future-bar" style="width:${barW}%"></div>
+      </div>
+      <span class="future-pct">${entry.implied}%</span>
+      <span class="future-ml">${mlStr}</span>
+    </div>`;
+}
+
+// ── View switching: hook into app.js nav ─────────────────────────────────────
+// app.js calls switchView(name) — we intercept the odds view activation
+const _origSwitchView = window.switchView;
+window.switchView = function(name) {
+  if (typeof _origSwitchView === 'function') _origSwitchView(name);
+  if (name === 'odds') loadOddsIfNeeded();
+};
+
+// Also handle direct nav button clicks in case switchView is defined after this script
+document.querySelectorAll('.nav-btn[data-view]').forEach(btn => {
+  btn.addEventListener('click', () => {
+    if (btn.dataset.view === 'odds') loadOddsIfNeeded();
+  });
+});
+
+window.loadOddsIfNeeded = loadOddsIfNeeded;
