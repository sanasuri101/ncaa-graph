+
+/* Open line + movement */
+.gc-open {
+  padding: 4px 12px;
+  font-size: .62rem;
+  font-family: var(--font-mono);
+  color: var(--text-dim);
+  border-bottom: 1px solid var(--border);
+}
+
+.gc-movement {
+  padding: 6px 12px;
+  font-size: .7rem;
+  color: var(--text);
+  background: var(--surface2);
+}
+
+.gc-movement strong { color: var(--accent); }
+
+.mv-badge {
+  display: inline-flex;
+  align-items: center;
+  gap: 2px;
+  font-size: .6rem;
+  font-family: var(--font-mono);
+  font-weight: 600;
+  padding: 1px 5px;
+  border-radius: 3px;
+}
+
+.mv-up   { background: rgba(58,140,110,.12); color: var(--west); }
+.mv-down { background: rgba(184,69,69,.12);  color: var(--midwest); }
+
+/* ── Futures ─────────────────────────────────────────────────────────────────── */
+.futures-page {
+  display: grid;
+  grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
+  gap: 20px;
+  align-items: start;
+}
+
+.futures-section {
+  background: var(--surface);
+  border: 1px solid var(--border);
+  border-radius: 10px;
+  padding: 14px 16px;
+}
+
+.futures-section-title {
+  font-family: 'Bebas Neue', sans-serif;
+  font-size: 1.05rem;
+  letter-spacing: .1em;
+  color: var(--text);
+  margin-bottom: 12px;
+  padding-bottom: 6px;
+  border-bottom: 1px solid var(--border);
+}
+
+.futures-region-title.east    { color: var(--east); }
+.futures-region-title.west    { color: var(--west); }
+.futures-region-title.south   { color: var(--south); }
+.futures-region-title.midwest { color: var(--midwest); }
+
+.futures-grid { display: flex; flex-direction: column; gap: 6px; }
+
+.future-row {
+  display: flex;
+  align-items: center;
+  gap: 7px;
+  padding: 5px 0;
+  border-bottom: 1px solid var(--border);
+}
+
+.future-row:last-child { border-bottom: none; }
+
+.future-rank {
+  font-size: .72rem;
+  flex-shrink: 0;
+  width: 22px;
+  text-align: center;
+}
+
+.future-name {
+  flex: 1;
+  font-size: .8rem;
+  font-weight: 500;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
