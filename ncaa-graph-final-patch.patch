+}
+
+.future-bar-wrap {
+  width: 60px;
+  height: 4px;
+  background: var(--surface3);
+  border-radius: 2px;
+  overflow: hidden;
+  flex-shrink: 0;
+}
+
+.future-bar {
+  height: 100%;
+  background: var(--accent);
+  border-radius: 2px;
+}
+
+.future-pct {
+  font-family: var(--font-mono);
+  font-size: .7rem;
+  font-weight: 600;
+  color: var(--accent);
+  width: 36px;
+  text-align: right;
+  flex-shrink: 0;
