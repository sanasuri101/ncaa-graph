 public/bracket.js |   45 +-
 public/index.html |  547 ++++++++++++------------
 public/odds.js    |  309 ++++++++++++++
 public/style.css  | 1034 ++++++++++++++++++++++++++++++++++++++++++++-
 5 files changed, 1708 insertions(+), 307 deletions(-)
 create mode 100644 public/odds.js

