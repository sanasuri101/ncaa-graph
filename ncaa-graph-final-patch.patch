+  align-items: center;
+  gap: 4px;
+  flex-shrink: 0;
+}
+
+.gtb-label {
+  font-size: .58rem;
+  font-family: var(--font-mono);
+  font-weight: 500;
+  letter-spacing: .07em;
+  color: var(--text-mute);
+  flex-shrink: 0;
+}
+
+.gtb-btn {
+  padding: 3px 8px;
+  border: 1px solid var(--border);
+  border-radius: 4px;
+  background: transparent;
+  color: var(--text-dim);
+  font-size: .72rem;
+  font-family: var(--font-body);
+  cursor: pointer;
+  transition: all .12s;
+  white-space: nowrap;
+}
+
+.gtb-btn:hover  { background: var(--surface2); color: var(--text); }
+.gtb-btn.active { background: var(--text); color: var(--bg); border-color: var(--text); }
+
+.gtb-icon {
+  width: 26px; height: 26px;
+  display: flex; align-items: center; justify-content: center;
+  border: 1px solid var(--border);
+  border-radius: 4px;
+  background: transparent;
+  color: var(--text-dim);
+  font-size: .75rem;
+  cursor: pointer;
+  transition: all .12s;
+}
+
+.gtb-icon:hover { background: var(--surface2); color: var(--text); }
+
+.gtb-sep {
+  width: 1px; height: 16px;
+  background: var(--border);
