+
+.future-ml {
+  font-family: var(--font-mono);
+  font-size: .68rem;
+  color: var(--text-dim);
+  width: 42px;
+  text-align: right;
+  flex-shrink: 0;
+}
+
+/* ══════════════════════════════════════════════════════════════════════════════
+   GRAPH VIEW — wraps existing graph + sidebar
+   ══════════════════════════════════════════════════════════════════════════════ */
+
+#view-graph { flex-direction: column; }
+
+.graph-toolbar {
+  display: flex;
+  align-items: center;
+  padding: 0 12px;
+  gap: 6px;
+  height: 40px;
