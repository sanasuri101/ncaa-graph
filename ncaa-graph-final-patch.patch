+}
+
+.gtb-search-wrap {
+  position: relative;
+  display: flex;
+  align-items: center;
+  gap: 4px;
+}
+
+.graph-toolbar input[type="text"] {
+  height: 26px;
+  padding: 0 8px;
+  border: 1px solid var(--border);
+  border-radius: 4px;
+  background: var(--bg);
+  color: var(--text);
+  font-size: .72rem;
+  font-family: var(--font-body);
+  width: 130px;
+  outline: none;
+}
+
+.graph-toolbar input[type="text"]:focus { border-color: var(--accent); }
+
+.graph-layout {
+  flex: 1;
+  min-height: 0;
