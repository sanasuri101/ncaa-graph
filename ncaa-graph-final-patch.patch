+  height: 5px;
+  background: var(--surface3);
+  border-radius: 3px;
+  overflow: hidden;
+}
+
+.gc-bpi-fill {
+  height: 100%;
+  background: var(--accent);
+  border-radius: 3px;
+  transition: width .4s ease;
+}
+
+.gc-bpi-quality {
+  font-size: .58rem;
+  font-family: var(--font-mono);
+  color: var(--text-mute);
+  flex-shrink: 0;
